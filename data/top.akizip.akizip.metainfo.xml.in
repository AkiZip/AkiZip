<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>top.akizip.akizip</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Akizip</name>
  <summary>A modern front-end for 7-Zip on GNOME</summary>
  <description>
    <p>Akizip is a graphical archive utility built with GTK 4 and libadwaita that brings the power of 7-Zip to the GNOME desktop.</p>
    <p>It supports creating and extracting archives in 7z, zip, and tar formats. It can also open (read-only) rar, gz, bz2, xz, tar.gz, tar.bz2, and tar.xz archives.</p>
    <p>Features include archive inspection, cancellable background jobs with progress reporting, a dedicated logs panel, and multilingual support.</p>
  </description>

  <developer id="github.com">
    <name>ckappgit</name>
  </developer>

  <url type="homepage">https://github.com/AkiZip/AkiZip</url>
  <url type="vcs-browser">https://github.com/AkiZip/AkiZip</url>
  <url type="bugtracker">https://github.com/AkiZip/AkiZip/issues</url>
  <url type="translate">https://hosted.weblate.org/engage/akizip/</url>

  <translation type="gettext">akizip</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">top.akizip.akizip.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#78aeed</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/AkiZip/AkiZip/refs/heads/master/docs/shotcut.png</image>
      <caption>Main window showing archive contents and toolbar</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.2.3" date="2026-05-13">
      <description translate="no">
        <p>New features and code cleanup</p>
        <ul>
          <li>Added remaining time display during operations</li>
          <li>Added support for xz and bz2 formats</li>
          <li>Disabled overwriting existing files when compressing</li>
          <li>Cleaned up deprecated and unused code</li>
        </ul>
      </description>
    </release>
    <release version="0.2.2" date="2026-05-09">
      <description translate="no">
        <p>Usability improvements and open-with support</p>
        <ul>
          <li>Adjusted encryption file name hint in compression dialog</li>
          <li>Added support for open-with</li>
          <li>Adjusted preferences descriptions</li>
          <li>Removed keyboard shortcuts dialog entry</li>
          <li>Fixed issue where encrypt file names could be selected for non-7z formats in preferences</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2026-05-09">
      <description translate="no">
        <p>Fix hard-coded timeout and add Italian support</p>
        <ul>
          <li>Fixed the hard-coded timeout issue</li>
          <li>Added Italian translation support</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-05-07">
      <description translate="no">
        <p>Support archive password</p>
        <ul>
          <li>Add password support for compressing and extracting archives</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-05-05">
      <description translate="no">
        <p>Initial release</p>
        <ul>
          <li>GTK 4 / libadwaita front-end for 7-Zip</li>
          <li>Support for compressing and extracting archives</li>
          <li>Archive inspection and testing</li>
          <li>Cancellable background jobs with progress reporting</li>
          <li>Logs panel for command output</li>
          <li>Multilingual support (English, Simplified Chinese, Traditional Chinese)</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
