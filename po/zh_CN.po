msgid "Akizip"
msgstr "Akizip"

#: data/top.akizip.akizip.desktop.in:8
msgid "GTK;"
msgstr "GTK;"

#: data/top.akizip.akizip.metainfo.xml.in:8
msgid "A modern front-end for 7-Zip on GNOME"
msgstr "GNOME 上 7-Zip 的现代化前端"

#: data/top.akizip.akizip.metainfo.xml.in:10
msgid ""
"Akizip is a graphical archive utility built with GTK 4 and libadwaita that "
"brings the power of 7-Zip to the GNOME desktop."
msgstr ""

#: data/top.akizip.akizip.metainfo.xml.in:11
msgid ""
"It supports creating and extracting archives in 7z, zip, and tar formats. It "
"can also open (read-only) rar, gz, bz2, xz, tar.gz, tar.bz2, and tar.xz "
"archives."
msgstr ""

#: data/top.akizip.akizip.metainfo.xml.in:12
msgid ""
"Features include archive inspection, cancellable background jobs with "
"progress reporting, a dedicated logs panel, and multilingual support."
msgstr ""

#: data/top.akizip.akizip.metainfo.xml.in:16
msgid "ckappgit"
msgstr "ckappgit"

#: data/top.akizip.akizip.metainfo.xml.in:40
