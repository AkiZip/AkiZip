import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

# Apply user-selected language before initializing gettext so that
# both Python _() calls and GtkBuilder translation pick it up.
try:
    import gi
    from gi.repository import Gio
    _settings = Gio.Settings.new('top.akizip.akizip')
    _lang = _settings.get_string('language')
    if _lang and _lang != 'auto':
        os.environ['LANGUAGE'] = _lang
        os.environ['LANG'] = _lang + '.UTF-8'
        try:
            locale.setlocale(locale.LC_ALL, _lang + '.UTF-8')
        except locale.Error:
            pass
    else:
        # Auto mode: in flatpak sandboxes LC_ALL is sometimes pinned to
        # en_US even when LANG reflects the user's actual language. Since
        # LC_ALL outranks LANG in gettext, the UI ends up English. Promote
        # LANG to LANGUAGE (which outranks LC_ALL for message lookups) so
        # the system language wins.
        if not os.environ.get('LANGUAGE'):
            _system_lang = (os.environ.get('LANG') or '').split('.')[0]
            if _system_lang and _system_lang not in ('C', 'POSIX'):
                os.environ['LANGUAGE'] = _system_lang
except Exception:
    pass

locale.bindtextdomain('akizip', localedir)
locale.textdomain('akizip')
gettext.bindtextdomain('akizip', localedir)
gettext.textdomain('akizip')

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'akizip.gresource'))
    resource._register()

    from akizip import main
    sys.exit(main.main(VERSION))
