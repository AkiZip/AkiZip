{
    "id" : "top.akizip.akizip",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "akizip",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "7zip",
            "buildsystem" : "simple",
            "build-commands" : [
                "tar -xf 7z2602-linux-x64.tar.xz",
                "install -Dm755 7zz /app/bin/7zz",
                "install -Dm755 7zzs /app/bin/7zzs"
            ],
            "sources" : [
                {
                    "type" : "file",
                    "url" : "https://github.com/ip7z/7zip/releases/download/26.02/7z2602-linux-x64.tar.xz",
                    "sha256" : "41aaba7b1235304ab5aa0624530c67ae829496cd29e875925271efdccc28c03e"
                }
            ]
        },
        {
            "name" : "python3-chardet",
            "buildsystem" : "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-deps chardet-5.2.0-py3-none-any.whl"
            ],
            "sources" : [
                {
                    "type" : "file",
                    "url" : "https://files.pythonhosted.org/packages/38/6f/f5fbc992a329ee4e0f288c1fe0e2ad9485ed064cac731ed2fe47dcc38cbf/chardet-5.2.0-py3-none-any.whl",
                    "sha256" : "e1cf59446890a00105fe7b7912492ea04b6e6f06d4b742b2c788469e34c82970"
                }
            ]
        },
        {
            "name" : "akizip",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path":"."
                }
            ]
        }
    ]
}
